{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and all associated data in a single document for simplicity in this version.",
      "type": "object",
      "properties": {
        "profile": { "type": "object" },
        "opportunities": { "type": "array" },
        "contacts": { "type": "array" },
        "companies": { "type": "array" },
        "calendarEvents": { "type": "array" },
        "documents": { "type": "array" },
        "chatSessions": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User's data document."
    }
  }
}
